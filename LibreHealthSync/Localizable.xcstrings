    "A red border appears on the Live Activity when the displayed reading is older than this threshold." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein roter Rahmen erscheint um die Live-Aktivität, wenn der angezeigte Messwert älter als dieser Schwellenwert ist."
          }
        }
      }
    },
    "About" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
