            "value" : "Konto"
          }
        }
      }
    },
    "Apple Health write access is turned off. Enable Blood Glucose for LibreHealth Sync under Settings > Health > Data Access & Devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schreibzugriff auf Apple Health ist deaktiviert. Aktiviere Blutzucker für LibreHealth Sync unter Einstellungen > Health > Datenzugriff & Geräte."
          }
        }
      }
    },
    "Are you sure you want to log out? Your stored credentials will be removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchtest du dich wirklich abmelden? Deine gespeicherten Zugangsdaten werden entfernt."
          }
        }
      }
    },
    "Authentication failed: %@" : {
      "localizations" : {
