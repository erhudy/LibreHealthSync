    "FAQ" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FAQ"
          }
        }
      }
    },
    "For liability reasons and because it would likely be rejected, because it declares that it needs the Audio playback Background Capability, in order to make iOS update from LibreLinkUp on an exacting schedule." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus Haftungsgründen und weil sie wahrscheinlich abgelehnt würde, da sie die Hintergrundfunktion für die Audiowiedergabe beansprucht, um iOS dazu zu bringen, nach einem genauen Zeitplan von LibreLinkUp zu aktualisieren."
          }
        }
      }
    },
    "Glucose Unit" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blutzuckereinheit"
          }
        }
      }
    },
    "HealthKit is not available on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HealthKit ist auf diesem Gerät nicht verfügbar."
          }
        }
      }
    },
    "How much data can this app sync from LibreLinkUp?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Daten kann diese App von LibreLinkUp synchronisieren?"
